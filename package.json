{
  "name": "workonit",
  "private": true,
  "version": "0.1.0",
  "description": "Kanban desktop local avec automatisations, construit avec Tauri, Rust et React.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NeKeR53/WorkOnIt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeKeR53/WorkOnIt.git"
  },
  "bugs": {
    "url": "https://github.com/NeKeR53/WorkOnIt/issues"
  },
  "keywords": [
    "automation",
    "desktop",
    "kanban",
    "local-first",
    "tauri"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "coverage": "vitest run --coverage",
    "licenses:check": "node scripts/check-js-licenses.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.32.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.10",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
